[Unit]
Description=OpenRGB SDK server bound to the loopback interface
Documentation=https://openrgb.org
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
ExecStart=/usr/bin/openrgb --server --server-host 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
LockPersonality=yes

[Install]
WantedBy=graphical-session.target
