pkgname=omarchy-alienware-bin
_pkgname=omarchy-alienware
pkgver=0.3.3
pkgrel=1
pkgdesc='Alienware fan, thermal, power and RGB control for Omarchy, prebuilt binary'
arch=('x86_64')
url='https://github.com/chr0nzz/omarchy-alienware'
license=('MIT')
depends=('dbus' 'polkit')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
optdepends=(
  'nvidia-utils: GPU power telemetry through nvidia-smi'
  'quickshell: runs the Omarchy bar widget and panel'
)
options=('!strip')
_dir="alienwarectl-${pkgver}-x86_64"
source=("${url}/releases/download/v${pkgver}/${_dir}.tar.gz")
sha256sums=('f1fccd5402a138a782df81553452ee99e652a5f6309c3258d6ec52d6a81f805c')

install=omarchy-alienware-bin.install

package() {
  cd "${srcdir}/${_dir}"

  install -Dm755 alienwarectl "${pkgdir}/usr/bin/alienwarectl"
  install -Dm644 packaging/systemd/alienwarectl.service \
    "${pkgdir}/usr/lib/systemd/system/alienwarectl.service"

  install -Dm644 packaging/dbus/org.xyzlab.Alienware1.conf \
    "${pkgdir}/usr/share/dbus-1/system.d/org.xyzlab.Alienware1.conf"
  install -Dm644 packaging/dbus/org.xyzlab.Alienware1.service \
    "${pkgdir}/usr/share/dbus-1/system-services/org.xyzlab.Alienware1.service"

  install -Dm644 packaging/polkit/org.xyzlab.alienware.policy \
    "${pkgdir}/usr/share/polkit-1/actions/org.xyzlab.alienware.policy"
  install -Dm644 packaging/polkit/49-alienware.rules \
    "${pkgdir}/usr/share/polkit-1/rules.d/49-alienware.rules"

  install -Dm644 packaging/udev/71-alienware-aw-elc.rules \
    "${pkgdir}/usr/lib/udev/rules.d/71-alienware-aw-elc.rules"

  install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
}
